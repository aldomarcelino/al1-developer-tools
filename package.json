{
  "name": "ramupod",
  "version": "1.0.0",
  "description": "Thoughtful online tools for documents, text, data, and everyday tasks.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "test": "node scripts/test.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "build:cloudflare": "vite build",
    "preview:cloudflare": "vite preview --host 127.0.0.1 --port 8787",
    "deploy": "vinext-cloudflare deploy",
    "deploy:dry-run": "vinext-cloudflare deploy --dry-run",
    "cf:typegen": "cf workers types",
    "test:seo": "node scripts/check-seo.mjs",
    "brand:generate": "node --experimental-strip-types scripts/generate-brand-assets.mjs",
    "test:security": "node scripts/check-security.mjs",
    "build:qa-extension": "node scripts/build-qa-extension.mjs",
    "dev:qa-fixture": "node scripts/qa-fixture/server.mjs",
    "test:qa-extension": "node scripts/qa-extension-e2e.mjs",
    "prebuild": "npm run build:qa-extension",
    "prebuild:cloudflare": "npm run build:qa-extension",
    "prebuild:vinext": "npm run build:qa-extension",
    "test:qa-quick": "node scripts/qa-quick-e2e.mjs",
    "postbuild:cloudflare": "npm run build:qa-extension",
    "postbuild:vinext": "npm run build:qa-extension",
    "test:qa-ui": "node scripts/qa-ui-e2e.mjs",
    "test:qa-viewer": "node scripts/qa-viewer-e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldomarcelino/al1-developer-tools.git"
  },
  "keywords": [
    "online-tools",
    "text-tools",
    "data-tools",
    "productivity",
    "utilities"
  ],
  "author": "Aldo Marcelino NF Lubis",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/aldomarcelino/al1-developer-tools/issues"
  },
  "homepage": "https://github.com/aldomarcelino/al1-developer-tools#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.6.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vinext/cloudflare": "^1.2.0",
    "cron-parser": "^5.10.2",
    "css-tree": "^3.2.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "svgo": "^4.1.0",
    "vinext": "^1.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "overrides": {
    "fflate": "0.8.3",
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
