{
  "manifest_version": 3,
  "name": "Ramupod",
  "short_name": "Ramupod",
  "version": "0.5.3",
  "description": "Capture browser evidence with local tab recordings, annotated screenshots, and QA network reports.",
  "minimum_chrome_version": "120",
  "devtools_page": "devtools.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "debugger",
    "tabCapture",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ramupod",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:43187/tools/qa-bug-report*",
        "https://ramupod.com/tools/qa-bug-report*",
        "https://dotools.com/tools/qa-bug-report*",
        "http://localhost:43187/tools/screen-recorder*",
        "https://ramupod.com/tools/screen-recorder*",
        "https://dotools.com/tools/screen-recorder*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
